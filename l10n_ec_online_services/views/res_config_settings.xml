<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="one_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_ec_online_services</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
            <app string="ReIdi" data-string="ReIdi" name="one_management">
                    <block title="URL" id="one_setting_container">                                                                        
                        <setting id="one_options">
                            <field name="use_reidi"/>
                            <div class="content-group" invisible="not group_product_variant">
                                <div class="mt8">
                                    <label for="reidi_url" class="o_form_label">ReIdi URL</label>
                                    <field name="reidi_api_url" class="o_field_char o_field_widget o_input"/>
                                </div>
                            </div>                            
                        </setting>
                    </block>                                        
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_one_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="one_res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'l10n_ec_online_services', 'bin_size': False}</field>
    </record>
</odoo>